{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning",
        "Microsoft.AspNetCore.Authentication": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Polly": "Warning"
      }
    }
  },
  "Application": {
    "SkipMigrationsAtStartup": false,
    "IgnoreZaakValidation": false,
    "AutomatischSluitenNaDagen": 3,
    "AutomatischSluitenIntervalMinuten": 60,
    "ApplyFixturesAtStartup": false,
    "CachedSecretExpirationTime": "00:03:00",
    "ResolveForwardedHost": true,
    "NummerGeneratorFormats": {
      "gesprekken": "G{yyyy}-{v^8}"
    }
  },
  "PollyConfig": {
    "AC": {
      "Retry": {
        "MaxRetryAttempts": 2,
        "BackoffType": "Constant",
        "Delay": "00:00:00.100"
      },
      "Timeout": {
        "Timeout": "00:00:30"
      }
    },
    "ZRC": {
      "Retry": {
        "MaxRetryAttempts": 2,
        "BackoffType": "Constant",
        "Delay": "00:00:00.100"
      },
      "Timeout": {
        "Timeout": "00:00:30"
      }
    }
  }
}
